<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Autophagy Track</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #09090b;
            --surface: #121215;
            --border: #27272a;
            --text-main: #fafafa;
            --text-muted: #a1a1aa;
            --accent: #e4e4e7;
            --accent-muted: #3f3f46;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2.5rem 1rem;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            width: 100%;
            max-width: 800px;
        }

        .header {
            margin-bottom: 2.5rem;
            border-bottom: 1px solid var(--border);
            padding-bottom: 1.25rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        h1 {
            font-size: 1.25rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            color: var(--text-main);
        }

        .header-meta {
            font-size: 0.8rem;
            color: var(--text-muted);
            font-family: 'JetBrains Mono', monospace;
        }

        .team-grid {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-bottom: 3rem;
        }

        .card {
            background-color: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 1.25rem 1.5rem;
            transition: border-color 0.2s ease;
        }

        .card:hover {
            border-color: #52525b;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .user-name {
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: -0.01em;
        }

        .user-stats {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .timer {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.95rem;
            font-weight: 500;
            color: var(--text-main);
        }

        .phase-tag {
            font-size: 0.7rem;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 4px;
            background: #27272a;
            color: #d4d4d8;
            letter-spacing: 0.02em;
            text-transform: uppercase;
        }

        .progress-box {
            position: relative;
            margin-bottom: 0.5rem;
        }

        .progress-track {
            width: 100%;
            height: 6px;
            background: #1e1e24;
            border-radius: 3px;
            overflow: hidden;
            position: relative;
        }

        .progress-fill {
            height: 100%;
            width: 0%;
            background: var(--accent);
            border-radius: 3px;
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .milestones {
            position: relative;
            height: 14px;
        }

        .ms-item {
            position: absolute;
            font-size: 0.65rem;
            font-weight: 500;
            font-family: 'JetBrains Mono', monospace;
            color: #52525b;
            transform: translateX(-50%);
        }

        .ms-item.passed {
            color: #a1a1aa;
        }

        .ref-section {
            border-top: 1px solid var(--border);
            padding-top: 1.5rem;
        }

        .ref-title {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

        .ref-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 0.75rem;
        }

        .ref-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 0.85rem 1rem;
        }

        .ref-card-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.3rem;
        }

        .ref-level {
            font-size: 0.65rem;
            font-weight: 600;
            color: #a1a1aa;
            font-family: 'JetBrains Mono', monospace;
        }

        .ref-time {
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        .ref-name {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--text-main);
            margin-bottom: 0.2rem;
        }

        .ref-desc {
            font-size: 0.72rem;
            color: #71717a;
            line-height: 1.4;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>Otofaji & Ketozis Takibi</h1>
        <div class="header-meta">162 SAAT HEDEF</div>
    </div>

    <div id="team-list" class="team-grid"></div>

    <div class="ref-section">
        <div class="ref-title">Metabolik Fazlar</div>
        <div id="ref-grid" class="ref-grid"></div>
    </div>
</div>

<script>
    const team = [
        { name: "Özer", startStr: "2026-09-06T18:00:00" },
        { name: "İrem", startStr: "2026-09-06T23:00:00" },
        { name: "Akın", startStr: "2026-09-08T00:00:00" },
        { name: "Erhan", startStr: "2026-09-08T01:18:00" },
        { name: "Gül", startStr: "2026-09-08T18:30:00" },
        { name: "Hacı", startStr: "2026-09-08T20:00:00" },
        { name: "Berkay", startStr: "2026-09-08T21:00:00" },
        { name: "Ertuğrul", startStr: "2026-09-09T09:10:00" }
    ];

    const stages = [
        { level: "FAZ 1", min: 0, max: 12, title: "Anabolik & Sindirim", desc: "Besin emilimi tamamlanıyor, kan şekeri dengeleniyor." },
        { level: "FAZ 2", min: 12, max: 24, title: "Lipoliz (Yağ Yakımı)", desc: "Glikojen depoları tükendi. İnsülin seviyesi dipte." },
        { level: "FAZ 3", min: 24, max: 48, title: "Ketozis & Otofaji", desc: "AMPK aktivasyonu ile hücresel temizlik başladı." },
        { level: "FAZ 4", min: 48, max: 72, title: "Derin Otofaji & HGH", desc: "Büyüme hormonu zirvede. Derin hücresel arınma." },
        { level: "FAZ 5", min: 72, max: 162, title: "İmmün Reset & Plato", desc: "Kök hücre aktivasyonu ve bağışıklık yenilenmesi." }
    ];

    const milestones = [
        { hours: 0, pct: 0, label: "0s" },
        { hours: 12, pct: 12, label: "12s" },
        { hours: 24, pct: 25, label: "24s" },
        { hours: 48, pct: 50, label: "48s" },
        { hours: 72, pct: 75, label: "72s" },
        { hours: 162, pct: 100, label: "162s" }
    ];

    function getStage(hours) {
        for (let s of stages) {
            if (hours >= s.min && hours < s.max) return s;
        }
        return hours >= 162 
            ? { level: "TAMAMLANDI", title: "Hedef", desc: "Süreç bitti." }
            : { level: "BEKLENİYOR", title: "Hazırlık", desc: "Başlamadı." };
    }

    function getPct(hours) {
        if (hours <= 0) return 0;
        if (hours >= 162) return 100;
        for (let i = 0; i < milestones.length - 1; i++) {
            let m1 = milestones[i], m2 = milestones[i+1];
            if (hours >= m1.hours && hours <= m2.hours) {
                return m1.pct + ((hours - m1.hours) / (m2.hours - m1.hours)) * (m2.pct - m1.pct);
            }
        }
        return 0;
    }

    function init() {
        const teamContainer = document.getElementById("team-list");
        teamContainer.innerHTML = team.map((m, i) => `
            <div class="card">
                <div class="card-header">
                    <div class="user-name">${m.name}</div>
                    <div class="user-stats">
                        <div class="timer" id="timer-${i}">0g 00s 00d</div>
                        <div class="phase-tag" id="tag-${i}">FAZ 1</div>
                    </div>
                </div>
                <div class="progress-box">
                    <div class="progress-track">
                        <div class="progress-fill" id="bar-${i}"></div>
                    </div>
                </div>
                <div class="milestones">
                    ${milestones.map(ms => `<span class="ms-item" id="ms-${i}-${ms.hours}" style="left: ${ms.pct}%">${ms.label}</span>`).join('')}
                </div>
            </div>
        `).join('');

        const refGrid = document.getElementById("ref-grid");
        refGrid.innerHTML = stages.map(s => `
            <div class="ref-card">
                <div class="ref-card-head">
                    <span class="ref-level">${s.level}</span>
                    <span class="ref-time">${s.min}-${s.max}s</span>
                </div>
                <div class="ref-name">${s.title}</div>
                <div class="ref-desc">${s.desc}</div>
            </div>
        `).join('');
    }

    function update() {
        const now = new Date();
        team.forEach((m, i) => {
            const elapsed = now - new Date(m.startStr);
            if (elapsed < 0) return;

            const totalHours = elapsed / (1000 * 60 * 60);
            const days = Math.floor(totalHours / 24);
            const hours = Math.floor(totalHours % 24);
            const mins = Math.floor((elapsed / (1000 * 60)) % 60);

            const pad = n => String(n).padStart(2, '0');
            document.getElementById(`timer-${i}`).innerText = `${days}g ${pad(hours)}s ${pad(mins)}d`;

            const pct = getPct(totalHours);
            document.getElementById(`bar-${i}`).style.width = `${pct}%`;

            const stage = getStage(totalHours);
            document.getElementById(`tag-${i}`).innerText = `${stage.level} · ${totalHours.toFixed(1)}s`;

            milestones.forEach(ms => {
                const elem = document.getElementById(`ms-${i}-${ms.hours}`);
                if (elem) {
                    if (totalHours >= ms.hours) elem.classList.add('passed');
                    else elem.classList.remove('passed');
                }
            });
        });
    }

    init();
    setInterval(update, 1000);
    update();
</script>

</body>
</html>
